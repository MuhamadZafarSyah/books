// ============================================================
// SHELFGRAM — Prisma Schema
// NextAuth v5 + Custom Email Registration
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Core User ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  username      String?
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  banner        String?
  bio           String?   @db.Text
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  chatParticipants ChatConversationParticipant[]
  chatMessages ChatMessage[]
  chatReads ChatMessageRead[]
  followers UserFollow[] @relation("UserFollowers")
  following UserFollow[] @relation("UserFollowing")
  books UserBook[]
  reviews BookReview[]
  quotes BookQuote[]
  bookAiConversations BookAiConversation[]
  readingCirclesOwned       ReadingCircle[]
  readingCircleMemberships  ReadingCircleMember[]
  readingCirclePosts        ReadingCirclePost[]
  readingCircleComments     ReadingCircleComment[]
  readingEventsHosted        ReadingEvent[]
  readingEventParticipations ReadingEventParticipant[]
  activityEvents             UserActivityEvent[]
  leaderboardSnapshots       UserLeaderboardSnapshot[]
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

enum UserBookStatus {
  WANT_TO_READ
  TO_BE_READ
  READING
  FINISHED
  ON_HOLD
  ABANDONED
}

enum UserBookVisibility {
  PRIVATE
  PUBLIC
  FOLLOWERS
}

model Book {
  id               String   @id @default(cuid())
  slug             String?  @unique
  workKey          String?  @unique
  editionKey       String?
  openLibraryUrl   String?
  title            String
  author           String
  coverUrl         String?
  description      String?  @db.Text
  firstPublishYear Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owners  UserBook[]
  reviews BookReview[]
  quotes  BookQuote[]

  @@index([editionKey])
}

model UserBook {
  id           String             @id @default(cuid())
  userId       String
  bookId       String
  status       UserBookStatus     @default(WANT_TO_READ)
  visibility   UserBookVisibility @default(PRIVATE)
  isBorrowable Boolean            @default(false)
  progress     Int?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([visibility, isBorrowable])
}

model BookReview {
  id         String             @id @default(cuid())
  userId     String
  bookId     String
  rating     Int?
  body       String             @db.Text
  visibility UserBookVisibility @default(PUBLIC)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, createdAt])
  @@index([bookId, createdAt])
}

enum ChatConversationType {
  DIRECT
  GROUP
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model ChatConversation {
  id            String                   @id @default(cuid())
  type          ChatConversationType     @default(DIRECT)
  title         String?
  directKey     String?                  @unique
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  lastMessageAt DateTime?

  participants ChatConversationParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
}

model ChatConversationParticipant {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  role           String           @default("member")
  joinedAt       DateTime         @default(now())
  lastReadAt     DateTime?
  archivedAt     DateTime?
  mutedUntil     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  body           String          @db.Text
  type           ChatMessageType @default(TEXT)
  clientId       String?         @unique
  createdAt      DateTime        @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  ChatMessageAttachment[]
  reads        ChatMessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ChatMessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  fileName  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ── NextAuth Standard Models ────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Custom: Pending Email Registration ──────────────────────

model PendingRegistration {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

// ── Reading Circle (Buddy Read / Community Discussion) ──────

enum ReadingCirclePrivacy {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ReadingCircleRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ReadingCirclePostType {
  DISCUSSION
  CHECKPOINT
  QUESTION
  ANNOUNCEMENT
  SYSTEM
}

enum ReadingCircleSpoilerLevel {
  NONE
  CHAPTER_RANGE
  MAJOR
  ENDING
}

model ReadingCircle {
  id                  String                @id @default(cuid())
  ownerId             String
  title               String
  description         String?               @db.Text
  privacy             ReadingCirclePrivacy  @default(PUBLIC)
  bookTitle           String
  bookAuthor          String
  bookCoverUrl        String?
  workKey             String?
  editionKey          String?
  openLibraryUrl      String?
  contextJson         Json
  targetLabel         String?
  targetChapterFrom   Int?
  targetChapterTo     Int?
  currentChapterFocus String?
  memberCount         Int                   @default(1)
  lastActivityAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  owner   User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members ReadingCircleMember[]
  posts   ReadingCirclePost[]

  @@index([ownerId, updatedAt])
  @@index([privacy, lastActivityAt])
  @@index([workKey])
  @@index([editionKey])
}

model ReadingCircleMember {
  id         String            @id @default(cuid())
  circleId   String
  userId     String
  role       ReadingCircleRole @default(MEMBER)
  joinedAt   DateTime          @default(now())
  lastSeenAt DateTime?

  circle ReadingCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId, joinedAt])
}

model ReadingCirclePost {
  id                 String                    @id @default(cuid())
  circleId           String
  authorId           String
  type               ReadingCirclePostType     @default(DISCUSSION)
  title              String?
  body               String                    @db.Text
  spoilerLevel       ReadingCircleSpoilerLevel @default(NONE)
  spoilerFromChapter Int?
  spoilerToChapter   Int?
  commentCount       Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  circle   ReadingCircle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  author   User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments ReadingCircleComment[]

  @@index([circleId, createdAt])
  @@index([authorId, createdAt])
}

model ReadingCircleComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   ReadingCirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

// ── Book AI Discussions ─────────────────────────────────────

enum BookAiMessageRole {
  USER
  ASSISTANT
}

model BookAiConversation {
  id             String    @id @default(cuid())
  userId         String
  title          String
  bookTitle      String
  bookAuthor     String
  bookCoverUrl   String?
  workKey        String?
  editionKey     String?
  openLibraryUrl String?
  contextJson    Json
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages BookAiMessage[]

  @@index([userId, updatedAt])
  @@index([userId, lastMessageAt])
}

model BookAiMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           BookAiMessageRole
  body           String            @db.Text
  createdAt      DateTime          @default(now())

  conversation BookAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Reading Events (Offline Reading Meetups) ────────────────

enum ReadingEventStatusFlag {
  ACTIVE
  CANCELLED
}

model ReadingEvent {
  id               String                 @id @default(cuid())
  hostId           String
  title            String
  description      String?                @db.Text
  locationAddress  String
  latitude         Float
  longitude        Float
  startsAt         DateTime
  endsAt           DateTime
  quota            Int
  participantCount Int                    @default(1)
  bookReferenceUrl String?
  statusFlag       ReadingEventStatusFlag @default(ACTIVE)
  cancelledAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  host         User                      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants ReadingEventParticipant[]

  @@index([startsAt, statusFlag])
  @@index([hostId, startsAt])
}

model ReadingEventParticipant {
  id       String   @id @default(cuid())
  eventId  String
  userId   String
  comment  String?
  joinedAt DateTime @default(now())

  event ReadingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, joinedAt])
  @@index([userId, joinedAt])
}

// ── Book Quotes (Highlight & Quote Collection) ─────────────

model BookQuote {
  id         String             @id @default(cuid())
  userId     String
  bookId     String
  quote      String             @db.Text
  note       String?            @db.Text
  page       Int?
  chapter    String?
  visibility UserBookVisibility @default(PRIVATE)
  isFavorite Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookId, createdAt])
  @@index([visibility, createdAt])
}

// ── Leaderboard / Activity Ledger ───────────────────────────

enum UserActivityType {
  READING_CIRCLE_CREATED
  READING_CIRCLE_JOINED
  READING_CIRCLE_POST_CREATED
  READING_CIRCLE_COMMENT_CREATED
  READING_EVENT_CREATED
  READING_EVENT_JOINED
  BOOK_REVIEW_CREATED
  BOOK_QUOTE_CREATED
  USER_FOLLOW_CREATED
}

enum UserActivitySourceType {
  READING_CIRCLE
  READING_CIRCLE_POST
  READING_CIRCLE_COMMENT
  READING_EVENT
  BOOK_REVIEW
  BOOK_QUOTE
  USER_FOLLOW
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum LeaderboardScope {
  OVERALL
  CIRCLES
  EVENTS
  REVIEWS
  SOCIAL
}

model UserActivityEvent {
  id           String                 @id @default(cuid())
  userId       String
  type         UserActivityType
  sourceType   UserActivitySourceType
  sourceId     String
  points       Int
  dedupeKey    String?                @unique
  metadataJson Json?
  createdAt    DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([sourceType, createdAt])
  @@index([createdAt])
}

model UserLeaderboardSnapshot {
  id            String            @id @default(cuid())
  userId        String
  period        LeaderboardPeriod
  scope         LeaderboardScope
  periodKey     String
  totalPoints   Int
  rank          Int?
  breakdownJson Json?
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, scope, periodKey])
  @@index([period, scope, periodKey, totalPoints])
}
